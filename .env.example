# OPENAI_API_KEY: Server-side API key for ChatGPT (OpenAI Vision) image-to-text reading.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# DEEPSEEK_API_KEY: Server-side API key for DeepSeek Vision image-to-text reading.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
